# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=n8n


# ============================================================
# n8n
# ============================================================

N8N_VERSION=latest
N8N_ENCRYPTION_KEY=generate_random_64_char_hex_key_here


# ============================================================
# Sandbox
# ============================================================

SANDBOX_API_KEYS=generate_random_64_char_hex_key_here
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=generate_random_64_char_hex_key_here
SANDBOX_API_RUNNER_API_KEY=generate_random_64_char_hex_key_here
N8N_SANDBOX_SERVICE_API_KEY=same_as_sandbox_api_keys


# ============================================================
# SearXNG
# ============================================================

SEARXNG_SECRET=generate_random_64_char_hex_key_here
